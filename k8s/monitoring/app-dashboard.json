{
  "uid": "app-overview",
  "title": "App overview",
  "schemaVersion": 39,
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate by route",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (route) (rate(http_requests_total[1m]))", "legendFormat": "{{route}}"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "5xx error rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) or vector(0)", "legendFormat": "5xx"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "p95 latency by route",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[1m])))", "legendFormat": "{{route}}"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "CPU per pod: usage vs request (cores)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"default\",pod=~\"app-.*\",container=\"app\"}[1m]))", "legendFormat": "{{pod}} usage"},
        {"refId": "B", "expr": "max by (pod) (kube_pod_container_resource_requests{namespace=\"default\",pod=~\"app-.*\",container=\"app\",resource=\"cpu\"})", "legendFormat": "{{pod}} request"}
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "App replicas",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16},
      "targets": [{"refId": "A", "expr": "kube_deployment_status_replicas{namespace=\"default\",deployment=\"app\"}", "legendFormat": "replicas"}]
    }
  ]
}
